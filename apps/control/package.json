{
  "name": "@qiyun/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/bootstrap.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@qiyun/contracts=../../packages/contracts/src/index.ts --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@qiyun/contracts": "0.1.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "node-forge": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/node-forge": "1.3.14",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
